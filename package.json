{
    "name": "Confinity",
    "version": "2.5.3",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "dist": "electron-builder --win"
    },
    "devDependencies": {
        "electron": "^42.4.0",
        "electron-builder": "^24.13.3"
    },
    "build": {
        "asarUnpack": [
            "**/node_modules/electron-chrome-web-store/**"
        ],
        "win": {
            "target": "nsis",
            "icon": "Confinity.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "runAfterFinish": true,
            "installerIcon": "Confinity.ico",
            "uninstallerIcon": "Confinity.ico",
            "installerHeaderIcon": "Confinity.ico"
        }
    },
    "dependencies": {
        "electron-chrome-web-store": "^0.13.0"
    },
    "overrides": {
        "adm-zip": "^0.6.0"
    }
}
